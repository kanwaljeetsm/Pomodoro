<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:keepScreenOn="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/appDrawLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:srcCompat="@drawable/drawpomo" />

        <com.uzairiqbal.circulartimerview.CircularTimerView
            android:id="@+id/progress_circular"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            app:progressColor="#000"
            app:backgroundColor="#2196F3"
            app:progressBackgroundColor="#eee"
            app:backgroundWidth="8"
            app:isClockwise="true"
            app:textSize="28sp"
            app:progressText=""
            app:maxValue="100"
            app:startingPoint="top"
            app:progressTextColor="#000"/>

        <EditText
            android:id="@+id/edtSessionName"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ems="10"
            android:gravity="center"
            android:hint="My Pomodoro Session"
            android:inputType="text"
            android:maxLength="26" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:background="@drawable/rounded"
            android:padding="10dp"
            android:textStyle="bold"
            android:textColor="@color/blue"
            android:textAllCaps="false"
            android:text="Start work session" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:background="@drawable/rounded"
            android:padding="10dp"
            android:textStyle="bold"
            android:textColor="@color/blue"
            android:visibility="gone"
            android:textAllCaps="false"
            android:text="End session" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>